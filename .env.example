# ============================================================================
# NETLIFY & CLIENT-SIDE ONLINE DATABASE CONFIGURATION (SUPABASE)
# ============================================================================
# Connect your free Supabase project so all products added from your website
# are immediately saved to the cloud and visible across all devices, mobile phones,
# incognito windows, and when sharing direct product links.
#
# Add these in Netlify: Site configuration -> Environment variables
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ============================================================================
# OPTIONAL FIREBASE CONFIGURATION (If using Firebase instead of Supabase)
# ============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ============================================================================
# PLATFORM ENVIRONMENT VARIABLES
# ============================================================================
GEMINI_API_KEY=""
APP_URL=""
