# ============================================================================
# NETLIFY & CLOUD DATABASE CONFIGURATION FOR DEALSONPOINT05.COM
# ============================================================================
# The website is fully wired to Firebase Firestore as the live real-time database.
# Because firebase-applet-config.json is bundled with the build, the database is
# automatically connected out-of-the-box when you deploy to Netlify!
#
# If you prefer to override configuration via Netlify environment variables
# in Netlify Site Configuration -> Environment Variables:
# ============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional secondary fallback (Supabase):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Platform variables
GEMINI_API_KEY=""
APP_URL=""
